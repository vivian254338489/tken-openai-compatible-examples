{
  "info": {
    "_postman_id": "5e6f1c34-6eb2-4b28-a7f8-78c6d1d31c5d",
    "name": "TKEN OpenAI-Compatible Smoke Tests",
    "description": "Smoke-test TKEN or another OpenAI-compatible /v1 endpoint without putting API keys in source control. Run GET /models first, choose a returned model ID, then run one non-streaming chat completion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tken_api_key}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const baseUrl = pm.collectionVariables.get('tken_base_url') || '';",
          "if (!baseUrl.endsWith('/v1')) {",
          "  console.warn('Expected tken_base_url to end with /v1. Current value: ' + baseUrl);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 GET /models",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('response has data array', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('data');",
              "  pm.expect(body.data).to.be.an('array');",
              "});",
              "",
              "const body = pm.response.json();",
              "if (Array.isArray(body.data) && body.data[0] && body.data[0].id) {",
              "  pm.collectionVariables.set('tken_model', body.data[0].id);",
              "  console.log('Set tken_model from /models:', body.data[0].id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{tken_base_url}}/models",
          "host": [
            "{{tken_base_url}}"
          ],
          "path": [
            "models"
          ]
        },
        "description": "Lowest-cost endpoint reachability check. Confirm this succeeds before selecting a chat model."
      },
      "response": []
    },
    {
      "name": "02 POST /chat/completions",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('response has at least one choice', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('choices');",
              "  pm.expect(body.choices).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "const body = pm.response.json();",
              "const preview = body && body.choices && body.choices[0] && body.choices[0].message ? body.choices[0].message.content : '';",
              "console.log('Redacted response preview:', String(preview).slice(0, 160));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"{{tken_model}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"{{tken_prompt}}\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{tken_base_url}}/chat/completions",
          "host": [
            "{{tken_base_url}}"
          ],
          "path": [
            "chat",
            "completions"
          ]
        },
        "description": "Run only after /models succeeds and tken_model is set to a returned model ID. Keep prompts non-sensitive."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "tken_base_url",
      "value": "https://www.tken.shop/v1",
      "type": "string"
    },
    {
      "key": "tken_api_key",
      "value": "sk-your-tken-key",
      "type": "string"
    },
    {
      "key": "tken_model",
      "value": "replace-with-an-available-model",
      "type": "string"
    },
    {
      "key": "tken_prompt",
      "value": "Reply with one short sentence for an API endpoint compatibility test.",
      "type": "string"
    }
  ]
}
