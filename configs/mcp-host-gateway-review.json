{
  "reviewProfileVersion": "0.17.0",
  "purpose": "Review an MCP-capable host that uses TKEN as an OpenAI-compatible model gateway.",
  "disclosure": "TKEN is an independent third-party OpenAI-compatible API gateway and is not officially affiliated with MCP hosts, IDE vendors, model providers, OpenAI, or the Model Context Protocol project.",
  "host": {
    "name": "replace-with-host-name",
    "owner": "replace-with-owner",
    "environment": "dev",
    "configFile": "replace-with-host-config-path",
    "supportsOpenAICompatibleBaseUrl": true
  },
  "modelGateway": {
    "baseUrlEnv": "TKEN_BASE_URL",
    "baseUrlExpectedValue": "https://www.tken.shop/v1",
    "apiKeyEnv": "TKEN_API_KEY",
    "modelEnv": "TKEN_MODEL",
    "selectedModelMustComeFromModelsEndpoint": true,
    "storeKeysInMcpServerConfig": false
  },
  "preflight": {
    "modelsCheck": {
      "required": true,
      "safeEvidence": ["status", "model_count", "selected_model", "timeout_ms"]
    },
    "nonStreamingChatCheck": {
      "requiredBeforeTools": true,
      "safeEvidence": ["status", "latency_ms", "selected_model", "failure_class"]
    },
    "streamingCheck": {
      "requiredOnlyIfHostUsesStreaming": true
    }
  },
  "mcpServers": [
    {
      "name": "replace-with-server-name",
      "transport": "stdio-or-http",
      "riskLevel": "read-only",
      "credentialsOwner": "server-or-host-secret-store",
      "usesTkenApiKey": false,
      "allowedActions": ["replace-with-read-action"],
      "blockedActionsUntilApproved": ["write", "delete", "purchase", "send-message"]
    }
  ],
  "permissionPlan": {
    "startWithNoTools": true,
    "firstToolRiskLevel": "read-only",
    "writeToolsRequireSeparateApproval": true,
    "networkToolsRequireSeparateApproval": true,
    "shellToolsRequireSeparateApproval": true
  },
  "limits": {
    "maxTurns": 10,
    "timeoutMs": 30000,
    "dailyBudgetUsd": "set-before-production",
    "rpmLimit": "set-before-production",
    "tpmLimit": "set-before-production"
  },
  "logging": {
    "redactApiKeys": true,
    "redactAccountIds": true,
    "redactPrompts": true,
    "redactToolOutputsContainingPrivateData": true,
    "safeFields": ["status", "latency_ms", "model", "failure_class", "mcp_server_name", "risk_level"]
  },
  "rollout": {
    "phase": "local-preflight",
    "rollbackOwner": "replace-with-owner",
    "goLiveGate": "models check, one non-streaming chat check, one no-tool host prompt, one read-only tool prompt, logging redaction verified"
  }
}
