TKEN_API_KEY=sk-your-tken-key

# Include the provider prefix in the value so LiteLLM routes to an OpenAI-compatible backend.
# Replace the placeholder with a model ID returned by https://www.tken.shop/v1/models.
TKEN_LITELLM_MODEL=openai/replace-with-an-available-model

# Local dev key only. Use a stronger value for any shared or public deployment.
LITELLM_MASTER_KEY=sk-dev-key

# For a private local smoke test this can match LITELLM_MASTER_KEY.
# For shared users, replace it with a LiteLLM virtual key with budget and rate limits.
OPENWEBUI_LITELLM_KEY=sk-dev-key
OPENWEBUI_DEFAULT_MODEL=tken-chat
